{
  "name": "stream-broadcast",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @broadcast/server dev & pnpm --filter @broadcast/client dev",
    "dev:server": "pnpm --filter @broadcast/server dev",
    "dev:client": "pnpm --filter @broadcast/client dev",
    "dev:mobile": "pnpm --filter @broadcast/mobile start",
    "build": "pnpm --filter @broadcast/shared build && pnpm --filter @broadcast/server build && pnpm --filter @broadcast/client build"
  },
  "engines": {
    "node": ">=18"
  }
}
